---
const currentPath = Astro.url.pathname;

const navLinks = [
  { path: '/greece/digital-nomad-visa', label: 'Digital Nomad Visa' },
  { path: '/greece/tax-number-afm', label: 'Tax Number (AFM)' },
  { path: '/greece/50-percent-tax-break', label: '50% Tax Break' },
  { path: '/greece/ongoing-bookkeeping', label: 'Bookkeeping' },
];
---
<header class="fixed top-4 left-4 right-4 md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-[calc(100%-2rem)] lg:max-w-7xl z-50 bg-white/50 backdrop-blur-2xl border border-slate-200/50 rounded-2xl shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      
      <!-- Logo (Left) -->
      <div class="flex-shrink-0 flex flex-col justify-center">
        <a href="/">
          <img src="/logo.svg" alt="taxomade Logo" class="h-8 w-auto" />
        </a>
        <span class="text-[10px] text-slate-500 font-bold mt-1 tracking-widest uppercase">The Tax Nomad Setup</span>
      </div>
      
      <!-- Right aligned section: Nav + CTA -->
      <div class="hidden md:flex items-center space-x-8 ml-auto">
        <nav class="flex items-center space-x-4 lg:space-x-8">
          {navLinks.map((link) => {
            const isActive = currentPath === link.path || currentPath === link.path + '/';
            return (
              <a 
                href={link.path} 
                class={`font-medium transition-all duration-200 ${isActive ? 'text-blue-800 bg-blue-50 px-3 py-1.5 rounded-lg shadow-sm border border-blue-100' : 'text-slate-600 hover:text-slate-900 px-3 py-1.5'}`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
        
        <div class="flex flex-col items-center">
          <a href="/call" class="inline-flex items-center justify-center pl-5 pr-3 py-2 text-sm font-bold rounded-lg text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 group">
            <span class="mr-3">Talk to us</span>
            <div class="flex">
              <img class="inline-block h-6 w-6 rounded-full ring-2 ring-blue-800 group-hover:ring-blue-900 object-cover" src="/images/founders.png" alt="Leonard & Manoli" />
            </div>
          </a>
          <a href="https://wa.me/491743426818" target="_blank" rel="noopener noreferrer" class="mt-1.5 flex items-center text-[10px] text-slate-500 hover:text-emerald-600 transition-colors group">
            <span class="relative flex h-2 w-2 mr-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <svg class="w-3.5 h-3.5 mr-1 text-emerald-500 group-hover:text-emerald-600 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            <span class="font-bold tracking-wide">+49 174 3426818</span>
          </a>
        </div>
      </div>

      <!-- Mobile Right Section (Menu only) -->
      <div class="flex items-center md:hidden ml-auto">
        <button id="mobile-menu-btn" aria-label="Menu" class="text-slate-600 hover:text-slate-900 focus:outline-none p-2 rounded-lg bg-transparent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white/95 backdrop-blur-xl rounded-b-2xl shadow-xl overflow-hidden">
    <div class="px-4 pt-2 pb-6 space-y-1">
      {navLinks.map((link) => (
        <a href={link.path} class="block px-3 py-3 rounded-lg text-base font-medium text-slate-700 hover:text-blue-800 hover:bg-blue-50 transition-colors">
          {link.label}
        </a>
      ))}
      <a href="/guides" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-700 hover:text-blue-800 hover:bg-blue-50 transition-colors">
        Guides
      </a>
      <div class="mt-4 px-3">
        <a href="/call" class="block w-full text-center px-5 py-3 text-base font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors shadow-sm">
          Call with us
        </a>
        <div class="mt-5 flex flex-col items-center border-t border-slate-100 pt-4">
          <p class="text-[11px] text-slate-500 mb-2 font-medium">We reply within hours, 7 days a week.</p>
          <a href="https://wa.me/491743426818" target="_blank" rel="noopener noreferrer" class="flex items-center text-sm font-bold text-emerald-800 hover:text-emerald-900 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition-colors group px-4 py-3 rounded-xl w-full justify-center shadow-sm">
            <span class="relative flex h-2.5 w-2.5 mr-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <svg class="w-4 h-4 mr-1.5 text-emerald-600 group-hover:text-emerald-700 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp schreiben
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if(btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        menu.classList.add('hidden');
      }
    });
  }
</script>
