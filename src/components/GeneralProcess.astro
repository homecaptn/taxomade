---
---
<section id="general-process" class="pt-12 md:pt-24 pb-8 md:pb-12 bg-slate-900 border-t border-slate-800 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-10 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-4 tracking-tight">How it works, <span class="text-slate-400">how little you do.</span></h2>
      <p class="text-lg text-slate-300">Our goal is to keep your to-do list as short as possible.</p>
    </div>

    <div class="relative">
      <!-- Central Line -->
      <div class="absolute left-1/2 top-4 bottom-4 w-[2px] bg-slate-800 -translate-x-1/2"></div>

      <!-- Step 1 -->
      <div class="relative flex flex-row items-center justify-between mb-8 md:mb-16 w-full">
        <div class="w-[45%] text-right pr-2 sm:pr-0">
          <div class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full bg-slate-800 text-slate-300 text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
            Step 1: Your part
          </div>
          <h3 class="text-base sm:text-xl font-bold text-white mb-1 sm:mb-2 leading-tight">Choose & submit</h3>
          <p class="text-slate-400 text-[11px] sm:text-sm leading-relaxed hidden sm:block">Find what you need via our configurator or select a single service. Upload your documents securely.</p>
        </div>
        
        <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-slate-900 border-2 border-slate-700 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
          1
        </div>
        
        <div class="w-[45%]"></div>
      </div>

      <!-- Step 2 -->
      <div class="relative flex flex-row items-center justify-between mb-8 md:mb-16 w-full">
        <div class="w-[45%]"></div>
        
        <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-blue-800 text-white text-xs sm:text-sm font-bold border-2 border-blue-800 z-10 shadow-sm">
          2
        </div>
        
        <div class="w-[45%] text-left pl-2 sm:pl-0">
          <div class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full bg-blue-900/50 text-blue-400 text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
            Step 2: taxomade®
          </div>
          <h3 class="text-base sm:text-xl font-bold text-white mb-1 sm:mb-2 leading-tight">We align (Optional)</h3>
          <p class="text-slate-400 text-[11px] sm:text-sm leading-relaxed hidden sm:block">We review your request and get in touch if anything is missing or hop on a quick call to answer questions.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative flex flex-row items-center justify-between w-full">
        <div class="w-[45%] text-right pr-2 sm:pr-0">
          <div class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full bg-slate-800 text-slate-400 text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
            Step 3: Your part
          </div>
          <h3 class="text-base sm:text-xl font-bold text-white mb-1 sm:mb-2 leading-tight">Sit back</h3>
          <p class="text-slate-500 text-[11px] sm:text-sm leading-relaxed hidden sm:block">Focus on your life and work while we handle the bureaucracy in the background.</p>
        </div>
        
        <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-emerald-500 text-white border-2 border-emerald-500 z-10 shadow-sm">
          <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        
        <div class="w-[45%] text-left pl-2 sm:pl-0">
          <div class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full bg-emerald-900/50 text-emerald-400 text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
            Step 3: taxomade®
          </div>
          <h3 class="text-base sm:text-xl font-bold text-white mb-1 sm:mb-2 leading-tight">We do the work</h3>
          <p class="text-slate-400 text-[11px] sm:text-sm leading-relaxed hidden sm:block">We file the applications, talk to local authorities, and deliver the final results right to your inbox.</p>
        </div>
      </div>
    </div>

    <!-- Notice -->
    <div class="mt-10 md:mt-20 max-w-2xl mx-auto bg-slate-800 border border-slate-700 rounded-2xl p-4 sm:p-6 text-center">
      <p class="text-[11px] sm:text-sm text-slate-300">
        <svg class="w-5 h-5 inline-block mr-1 -mt-0.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        The detailed process for each specific service can be found on the respective <a href="#how-it-works" class="font-bold text-white underline hover:text-blue-400">service pages</a>.
      </p>
    </div>

  </div>
</section>
