---
const PIXEL_ID = '4511342435789098';
---
<!-- Meta Pixel Code (consent-gated) -->
<script is:inline define:vars={{ PIXEL_ID }}>
  // Standard Meta base code, with one change: it does NOT inject fbevents.js yet.
  // The stub queues every fbq() call, and fbevents.js drains that queue once it
  // loads — so nothing is sent to Meta (and no cookie is set) until the visitor
  // consents to marketing, while PageView/Lead still end up tracked afterwards.
  (function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
  })(window, document, 'script');

  fbq('init', PIXEL_ID);
  fbq('track', 'PageView');

  (function () {
    var requested = false;

    function loadMetaPixel() {
      if (requested) return;
      requested = true;
      var t = document.createElement('script');
      t.async = true;
      t.src = 'https://connect.facebook.net/en_US/fbevents.js';
      var s = document.getElementsByTagName('script')[0];
      s.parentNode.insertBefore(t, s);
    }

    // Returning visitor who already accepted: load right away.
    try {
      if (localStorage.getItem('taxomade_cookie_consent') === 'accepted') {
        loadMetaPixel();
      }
    } catch (e) {
      /* localStorage blocked — stay opted out */
    }

    // First visit: wait for the cookie banner to signal consent.
    window.addEventListener('taxomade:marketing-consent', loadMetaPixel);
  })();
</script>
<!-- End Meta Pixel Code -->
<!--
  No <noscript> tracking pixel on purpose: that <img> would fire on every page
  load before any consent decision, which is exactly what the GDPR gate prevents.
-->
