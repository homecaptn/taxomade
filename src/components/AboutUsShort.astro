---
---
<section class="py-12 md:py-24 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="text-xs md:text-sm font-bold text-blue-800 uppercase tracking-widest mb-3 md:mb-4 block">About taxomade®</span>
      <h2 class="text-2xl md:text-4xl font-bold text-slate-900 mb-6 leading-tight">Your partner for relocation and taxes in Southern Europe.</h2>
      
      <div class="prose prose-base md:prose-lg text-slate-600 mb-10 leading-relaxed mx-auto text-left">
        <p>Moving to a new country as a remote worker or freelancer can be confusing, expensive, and slow. We built taxomade® as the service we wished existed when we relocated ourselves — several times.</p>
        <p>We're a simple, digital-first partner that handles your visa, tax registration, and ongoing bookkeeping entirely for you — and we stay your long-term partner long after you arrive. Transparent, affordable, and fully remote. You enjoy life under the Mediterranean sun; we take care of the paperwork.</p>
      </div>
      
    </div>

    <!-- The Team (Row of 3) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-12">
      <!-- Founders -->
      <div class="flex flex-col items-center">
        <div class="w-full aspect-square bg-slate-100 rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-4">
          <img src="/images/founders.png" alt="Leonard & Manoli" class="w-full h-full object-cover object-center" />
        </div>
        <div class="text-center px-2">
          <strong class="text-slate-900 block text-base mb-1">Leonard & Manoli</strong>
          <span class="text-slate-500 text-sm block mb-1">Managing Partners</span>
          <span class="text-slate-400 text-xs uppercase tracking-wider font-bold">Strategy &middot; Setup &middot; Support</span>
        </div>
      </div>

      <!-- Ioanna -->
      <div class="flex flex-col items-center">
        <div class="w-full aspect-square bg-slate-100 rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-4">
          <img src="/images/ioanna.jpg" alt="Ioanna" class="w-full h-full object-cover object-top" />
        </div>
        <div class="text-center px-2">
          <div class="flex items-center justify-center gap-2 mb-1 flex-wrap">
            <strong class="text-slate-900 text-base">Ioanna</strong>
            <div class="relative group/badge inline-block cursor-help">
              <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide transition-colors group-hover/badge:bg-emerald-100 group-hover/badge:border-emerald-300">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                State-Certified
              </div>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 opacity-0 invisible group-hover/badge:opacity-100 group-hover/badge:visible transition-all duration-200 z-20">
                <div class="bg-slate-900 text-white text-xs p-2.5 rounded-lg shadow-xl text-center leading-relaxed">
                  Registered with the Economic Chamber of Greece<br/><span class="text-slate-400 font-mono text-[10px] mt-1 block">License: 0137209</span>
                </div>
                <div class="w-2.5 h-2.5 bg-slate-900 transform rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2"></div>
              </div>
            </div>
          </div>
          <span class="text-slate-500 text-sm block mb-1">Accounting</span>
          <span class="text-slate-400 text-xs uppercase tracking-wider font-bold block">Registrations &middot; Bookkeeping &middot; Tax filings</span>
        </div>
      </div>

      <!-- Paraskevi -->
      <div class="flex flex-col items-center">
        <div class="w-full aspect-square bg-slate-100 rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-4">
          <img src="/images/paraskevi.jpg" alt="Paraskevi" class="w-full h-full object-cover object-top" />
        </div>
        <div class="text-center px-2">
          <div class="flex items-center justify-center gap-2 mb-1 flex-wrap">
            <strong class="text-slate-900 text-base">Paraskevi</strong>
            <div class="relative group/badge inline-block cursor-help">
              <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide transition-colors group-hover/badge:bg-emerald-100 group-hover/badge:border-emerald-300">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                State-Certified
              </div>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 opacity-0 invisible group-hover/badge:opacity-100 group-hover/badge:visible transition-all duration-200 z-20">
                <div class="bg-slate-900 text-white text-xs p-2.5 rounded-lg shadow-xl text-center leading-relaxed">
                  Registered with the Athens Bar Association<br/><span class="text-slate-400 font-mono text-[10px] mt-1 block">Official Attorney at Law</span>
                </div>
                <div class="w-2.5 h-2.5 bg-slate-900 transform rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2"></div>
              </div>
            </div>
          </div>
          <span class="text-slate-500 text-sm block mb-1">Legal</span>
          <span class="text-slate-400 text-xs uppercase tracking-wider font-bold">Visas &middot; Permits &middot; Legal filings</span>
        </div>
      </div>
    </div>

    <!-- About Taxomade Box -->
    <div class="max-w-4xl mx-auto mb-12">
      <div class="bg-slate-900 rounded-3xl shadow-2xl border border-slate-800 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500 rounded-bl-full opacity-20 -z-0"></div>
        <div class="absolute top-0 left-0 w-full h-1 bg-emerald-400"></div>
        <div class="p-6 md:p-10 relative z-10">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-8 border-b border-slate-800 pb-4 text-center">About taxomade</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            <div class="flex flex-col items-center text-center">
              <div class="w-12 h-12 bg-slate-800 text-emerald-400 rounded-xl flex items-center justify-center mb-4 shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <span class="font-bold text-white block text-sm mb-1.5">Focus</span>
              <span class="text-slate-400 text-sm">Freelancers & Remote Workers</span>
            </div>
            <div class="flex flex-col items-center text-center">
              <div class="w-12 h-12 bg-slate-800 text-blue-400 rounded-xl flex items-center justify-center mb-4 shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <span class="font-bold text-white block text-sm mb-1.5">Operations</span>
              <span class="text-slate-400 text-sm">100% Digital & Remote</span>
            </div>
            <div class="flex flex-col items-center text-center">
              <div class="w-12 h-12 bg-slate-800 text-purple-400 rounded-xl flex items-center justify-center mb-4 shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <span class="font-bold text-white block text-sm mb-1.5">Licensed professionals</span>
              <span class="text-slate-400 text-sm">Every filing handled by our licensed experts.</span>
            </div>
          </div>
          <div class="text-center pt-6 border-t border-slate-800">
            <span class="text-slate-300 text-sm font-medium">🗣️ We speak <strong class="text-white">English, German, Spanish and Greek</strong>.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
