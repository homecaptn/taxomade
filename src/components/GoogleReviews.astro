---
import data from '../data/google-reviews.json';
const reviews = (data.reviews || []).filter((r) => r.rating >= 4)
  .sort((a, b) => String(b.publishTime || '').localeCompare(String(a.publishTime || '')))
  .slice(0, 5);
const show = reviews.length > 0 && data.rating;
const stars = (n) => Array.from({ length: 5 }, (_, i) => i < Math.round(n));
const fmt = (n) => Number(n).toFixed(1);
---
{show && (
<section id="reviews" class="py-20 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">What our clients say</h2>
      <a href={data.mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-full px-5 py-2.5 hover:border-slate-300 transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
        <span class="font-bold text-slate-900">{fmt(data.rating)}</span>
        <span class="flex text-amber-400" aria-label={`${fmt(data.rating)} out of 5 stars`}>
          {stars(data.rating).map((on) => <svg class={`w-4 h-4 ${on ? '' : 'text-slate-300'}`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z"/></svg>)}
        </span>
        <span class="text-sm text-slate-500">Reviews on Google</span>
      </a>
    </div>

    <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 sm:mx-0 sm:px-0" style="scrollbar-width: thin;">
      {reviews.map((r) => (
        <figure class="snap-start shrink-0 w-[85%] sm:w-[360px] bg-slate-50 border border-slate-100 rounded-2xl p-6 flex flex-col">
          <div class="flex text-amber-400 mb-3" aria-label={`${r.rating} out of 5 stars`}>
            {stars(r.rating).map((on) => <svg class={`w-4 h-4 ${on ? '' : 'text-slate-300'}`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z"/></svg>)}
          </div>
          <blockquote class="text-slate-700 text-[15px] leading-relaxed flex-1 line-clamp-[9]">{r.text}</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            {r.photo
              ? <img src={r.photo} alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" class="w-9 h-9 rounded-full" />
              : <span class="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold">{r.author.slice(0, 1)}</span>}
            <div class="text-sm">
              {r.authorUrl
                ? <a href={r.authorUrl} target="_blank" rel="noopener nofollow" class="font-semibold text-slate-900 hover:underline">{r.author}</a>
                : <span class="font-semibold text-slate-900">{r.author}</span>}
              <div class="text-slate-500">{r.when}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={data.mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center text-sm font-semibold text-blue-700 hover:text-blue-900">Read all reviews on Google →</a>
      <p class="mt-2 text-xs text-slate-400">Reviews from Google</p>
    </div>
  </div>
</section>
)}
