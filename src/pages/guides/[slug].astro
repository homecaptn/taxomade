---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const guideEntries = await getCollection('guides');
  return guideEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const alternates = entry.data.translationOf
  ? [{ lang: 'en', href: `/guides/${entry.id}` }, { lang: 'de', href: `/de/ratgeber/${entry.data.translationOf}` }]
  : [];

// Map category to a specific service URL for the back button / CTA
const serviceUrls = {
  dnv: '/greece/digital-nomad-visa',
  afm: '/greece/tax-number-afm',
  tax: '/greece/50-percent-tax-break',
  bookkeeping: '/greece/ongoing-bookkeeping',
};
const backUrl = serviceUrls[entry.data.category] || '/';
const asOfDate = entry.data.updatedDate || entry.data.pubDate;
const asOf = asOfDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const checkUrl = `https://wa.me/491743426818?text=${encodeURIComponent(`Hi taxomade, I read your guide "${entry.data.title}" and would like a free check of my situation.`)}`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image ? `https://taxomade.com${entry.data.image}` : "https://taxomade.com/images/logo.svg",
  "author": {
    "@type": "Organization",
    "name": "taxomade"
  },
  "publisher": {
    "@type": "Organization",
    "name": "taxomade",
    "logo": {
      "@type": "ImageObject",
      "url": "https://taxomade.com/images/logo.svg"
    }
  },
  "datePublished": entry.data.pubDate.toISOString(),
  ...(entry.data.updatedDate && { "dateModified": entry.data.updatedDate.toISOString() })
};

// Optional FAQPage schema, built from the `faq` frontmatter of a guide
const faqSchema = entry.data.faq && entry.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": entry.data.faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<Layout title={`${entry.data.title} | taxomade Knowledge Hub`} description={entry.data.description} image={entry.data.image || '/images/logo.svg'} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  <div class="pt-32 pb-16 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <a href={backUrl} class="inline-flex items-center text-sm font-bold text-blue-800 hover:text-blue-900 mb-8 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Service
      </a>
      {entry.data.translationOf && (
        <a href={`/de/ratgeber/${entry.data.translationOf}`} class="float-right text-sm font-bold text-slate-500 hover:text-blue-800 mb-8" lang="de">Auf Deutsch lesen →</a>
      )}

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center text-sm font-bold text-blue-800 bg-blue-50 px-3 py-1 rounded-full mb-6 uppercase tracking-wider">
          {entry.data.category}
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight leading-tight">
          {entry.data.title}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {entry.data.description}
        </p>
        <div class="text-sm font-medium text-slate-500">
          By the taxomade team · Published on <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          {entry.data.updatedDate && (
            <> · Updated <time datetime={entry.data.updatedDate.toISOString()}>
              {entry.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time></>
          )}
        </div>
      </div>

      <!-- Hero Image -->
      {entry.data.image && (
        <div class="max-w-4xl mx-auto mb-16 rounded-2xl overflow-hidden shadow-xl border border-slate-200">
          <img src={entry.data.image} alt={entry.data.title} class="w-full h-auto object-cover aspect-[16/9]" />
        </div>
      )}

      <!-- Early CTA (compact) -->
      <div class="not-prose mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-emerald-50 border border-emerald-100 rounded-2xl px-6 py-5">
        <p class="text-slate-800 font-semibold leading-snug">Not sure how this applies to you?<span class="block text-sm font-normal text-slate-600">Free check via WhatsApp — we reply the same day.</span></p>
        <a href={checkUrl} target="_blank" rel="noopener noreferrer" data-cta="guide-check-top" class="shrink-0 inline-flex items-center justify-center px-5 py-3 text-sm font-bold rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 transition-colors">Get a free check</a>
      </div>

      <!-- Article Content (Prose) -->
      <article class="prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-a:text-blue-800 hover:prose-a:text-blue-900 prose-img:rounded-xl">
        <Content />
      </article>

      <!-- Mid-article CTA (moved into the article before the 3rd H2 by the script below) -->
      <template id="guide-mid-cta">
        <div class="not-prose my-10 bg-slate-900 text-white rounded-2xl px-6 py-6 sm:px-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <p class="font-bold text-lg leading-snug">Every situation is different.<span class="block text-sm font-normal text-slate-300">Send us your case — we check it for free and reply the same day, in English, German, Spanish or Greek.</span></p>
          <a href={checkUrl} target="_blank" rel="noopener noreferrer" data-cta="guide-check-mid" class="shrink-0 inline-flex items-center justify-center px-5 py-3 text-sm font-bold rounded-xl text-slate-900 bg-white hover:bg-emerald-50 transition-colors">Free check via WhatsApp</a>
        </div>
      </template>

      <!-- Sticky mobile CTA -->
      <a id="guide-sticky-cta" href={checkUrl} target="_blank" rel="noopener noreferrer" data-cta="guide-check-sticky" class="md:hidden fixed bottom-4 left-4 right-4 z-40 hidden items-center justify-center px-5 py-3.5 text-base font-bold rounded-xl text-white bg-emerald-600 shadow-xl">Free check via WhatsApp</a>

      <!-- Closing line + CTA -->
      <p class="mt-12 text-slate-600 italic">
        Rules as of {asOf}. Every situation is different — <a href={checkUrl} target="_blank" rel="noopener noreferrer" class="text-blue-800 font-semibold not-italic hover:text-blue-900">we check yours for free</a>.
        <span class="block mt-2 text-sm not-italic text-slate-500">How we research and update our guides: <a href="/editorial-standards" class="underline hover:text-slate-700">editorial standards</a>.</span>
      </p>

      <div id="guide-end-cta" class="mt-10 bg-slate-50 p-8 rounded-2xl border border-slate-100 text-center">
        <h3 class="text-2xl font-bold text-slate-900 mb-3">Want us to check your situation?</h3>
        <p class="text-slate-600 mb-6">Send us a short message — we reply the same day, in English, German, Spanish or Greek.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={checkUrl} target="_blank" rel="noopener noreferrer" data-cta="guide-free-check" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 shadow-md">
            Free check via WhatsApp
          </a>
          <a href={backUrl} class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-slate-900 bg-white border border-slate-200 hover:border-slate-400 transition-colors duration-200">
            View our service
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var article = document.querySelector('article.prose');
      var tpl = document.getElementById('guide-mid-cta');
      if (article && tpl) {
        var h2s = article.querySelectorAll('h2');
        var target = h2s.length >= 4 ? h2s[2] : (h2s.length >= 2 ? h2s[h2s.length - 1] : null);
        if (target) target.parentNode.insertBefore(tpl.content.cloneNode(true), target);
      }
      // Sticky mobile button: show after 25% scroll, hide when the end CTA or the cookie banner is visible.
      var sticky = document.getElementById('guide-sticky-cta');
      var end = document.getElementById('guide-end-cta');
      if (sticky) {
        var update = function () {
          var doc = document.documentElement;
          var progress = (window.scrollY + window.innerHeight) / doc.scrollHeight;
          var endVisible = end && end.getBoundingClientRect().top < window.innerHeight;
          var banner = document.getElementById('cookie-banner');
          var bannerOpen = banner && !banner.classList.contains('hidden');
          var show = progress > 0.25 && !endVisible && !bannerOpen;
          sticky.classList.toggle('hidden', !show);
          sticky.classList.toggle('flex', show);
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
      // Track which CTA position gets clicked (GTM/GA4 via dataLayer).
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[data-cta^="guide-"]') : null;
        if (!a) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'whatsapp_cta_click', cta_position: a.getAttribute('data-cta'), page_path: location.pathname });
      }, true);
    })();
  </script>
</Layout>
