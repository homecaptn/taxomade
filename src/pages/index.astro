---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Timeline from '../components/Timeline.astro';
import GeneralProcess from '../components/GeneralProcess.astro';
import Configurator from '../components/Configurator.astro';
import Simplicity from '../components/Simplicity.astro';

import Trust from '../components/Trust.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import AboutUs from '../components/AboutUs.astro';
import Prices from '../components/Prices.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
---
<Layout title="taxomade | Relocate to Greece" description="Your reliable partner for remote worker relocation and tax compliance in Greece. We handle your Digital Nomad Visa, AFM, and taxes 100% digitally." image="/images/dnv_hero_santorini.png">
  <main class="min-h-screen">
    <Hero />
    <WhatWeDo />
    <Timeline />
    <GeneralProcess />
    <AboutUs />
    <Configurator />
    <Simplicity />

    <Trust />
    <Contact />
    <RelatedGuides title="From our Knowledge Hub" subtitle="Explore our latest resources on relocating and doing business in Greece." />
    

  </main>
  <Footer />
</Layout>
