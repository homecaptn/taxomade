---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import AboutUsShort from '../../components/AboutUsShort.astro';
import ServiceContactForm from '../../components/ServiceContactForm.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import TrustPromise from '../../components/TrustPromise.astro';
---

<Layout title="Digital Nomad Visa Greece | Taxomade" description="Get your Greek Digital Nomad Visa. We handle the entire application process, from document collection to your residence permit." image="/images/dnv_hero_santorini.png">
  <!-- Section 1: Hero (Conversion Optimized) -->
  <div class="relative pt-32 pb-8 md:pt-40 md:pb-32 overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-white/80 via-white/50 to-slate-50/20"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Copy & CTAs -->
        <div class="max-w-2xl">
          <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tight leading-tight">
            Your Digital Nomad Visa for Greece, made simple.
          </h1>
          <p class="text-xl text-slate-600 mb-8 leading-relaxed">
            Live and work remotely in Greece — we guide you through the whole application.
          </p>
          
          <!-- Benefit Checkmarks -->
          <ul class="space-y-3 mb-10">
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Fully managed, end-to-end process
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Document prep & translations handled
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Handled by our licensed professionals
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              All communication in plain English
            </li>
          </ul>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <a href="#contact-form" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 shadow-md">
              Get started
            </a>
            <a href="/call" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-slate-700 bg-white border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors duration-200">
              Book a free call
            </a>
          </div>
          <p class="text-sm text-slate-500 font-medium flex items-center mb-1">
            <svg class="w-4 h-4 text-slate-400 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path></svg>
            Trusted by remote workers moving to Greece
          </p>
          <p class="text-sm text-slate-500 font-medium flex items-center">
            <svg class="w-4 h-4 text-slate-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            We reply within hours, 7 days a week.
          </p>
        </div>
        
        <!-- Right: Visual Mockup -->
        <div class="flex justify-center lg:justify-end relative mt-2 md:mt-12 lg:mt-0">
          <div class="relative w-full max-w-lg">
            <!-- Decorative background element -->
            <div class="absolute inset-0 bg-gradient-to-tr from-blue-200 to-emerald-100 rounded-3xl transform rotate-2 scale-105 opacity-60"></div>
            
            <!-- Main Image -->
            <img src="/dnv_hero_iphone_chart.png" alt="Digital Nomad closed laptop and iPhone with trading chart in Santorini Greece" class="relative z-10 w-full h-[350px] sm:h-[500px] object-cover rounded-3xl shadow-2xl border-4 border-white" />
            
            <!-- Floating Trust Badge -->
            <div class="absolute -bottom-6 -left-6 z-20 bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-xl border border-white flex items-center gap-4">
              <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">100% Remote Process</p>
                <p class="text-[11px] text-slate-500">We handle the bureaucracy</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="py-4 md:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Why Greece DNV Section -->
    <div class="mb-24">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">Why the Greek <span class="text-blue-800">Digital Nomad Visa?</span></h2>
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">More than just a visa. It's a gateway to European residency, the ability to bring your family, and an unmatched Mediterranean lifestyle.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        <!-- Benefit 1 -->
        <div class="bg-blue-50/80 rounded-3xl p-6 md:p-8 border border-blue-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Travel the Entire Schengen Area</h3>
          <p class="text-slate-600 leading-relaxed text-sm">The Greek residence permit grants you free movement across all 27 Schengen countries. The restrictive 90-day limit is history.</p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-emerald-50/80 rounded-3xl p-6 md:p-8 border border-emerald-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-emerald-500 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Bring Your Family</h3>
          <p class="text-slate-600 leading-relaxed text-sm">The Greek Digital Nomad Visa allows for family reunification. Your spouse and dependent children can join you and receive their own residence permits.</p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-purple-50/80 rounded-3xl p-6 md:p-8 border border-purple-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-purple-600 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Path to EU Citizenship</h3>
          <p class="text-slate-600 leading-relaxed text-sm">The visa is granted initially for 1 to 2 years and can be renewed indefinitely. It offers a perfectly legal pathway to long-term residency and eventually Greek (EU) citizenship.</p>
        </div>

        <!-- Benefit 4 -->
        <div class="bg-orange-50/80 rounded-3xl p-6 md:p-8 border border-orange-100 hover:shadow-xl transition-all duration-300 md:col-span-1 lg:col-span-2 flex flex-col sm:flex-row items-start sm:items-center gap-4 md:gap-6">
          <div class="w-12 h-12 bg-orange-500 text-white rounded-xl flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Premium Mediterranean Lifestyle</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Keep your high-paying foreign job while living in a country where rent, food, and daily life cost a fraction of the US or UK. Instant lifestyle upgrade.</p>
          </div>
        </div>

        <!-- Benefit 5 -->
        <div class="bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-800 text-white hover:shadow-xl transition-all duration-300 relative overflow-hidden group">
          <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-blue-600/20 rounded-full blur-2xl group-hover:bg-blue-600/40 transition-colors"></div>
          <div class="w-12 h-12 bg-slate-800 text-blue-400 rounded-xl flex items-center justify-center mb-6 shadow-sm border border-slate-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">100% Done-For-You</h3>
          <p class="text-slate-400 leading-relaxed text-sm">Greek bureaucracy is notorious. We handle translations, appointments, and applications entirely remotely for your peace of mind.</p>
        </div>
      </div>
    </div>

    <!-- Removed Section 2: Service Overview & Requirements (Essentials) -->
    <section class="max-w-4xl mx-auto mb-24 px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight">How it works, <span class="text-slate-400">how little you do.</span></h2>
        <p class="text-lg text-slate-600">We handle the heavy lifting of your visa application.</p>
      </div>
      
      <div class="relative">
        <!-- Central Line -->
        <div class="absolute left-1/2 top-4 bottom-4 w-[2px] bg-slate-100 -translate-x-1/2"></div>
        
        <!-- Step 1 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">~1 week</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Gather documents</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Send your passport, income proof & request your criminal record at home.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            1
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Checklist & Prep</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We give you the exact checklist, prepare your forms & declaration, and organize all translations.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">~1 day</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Pick insurance</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Get a private health insurance policy (required for the visa).</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            2
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Recommendations</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We can recommend trusted options, or you can choose your own — usually sorted in a day.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">varies</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Apostilles</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">One quick errand at home — we tell you exactly where to go.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            3
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Translation & Legalization</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We send you the precise authority for your country and handle the certified translations.</p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">1-3 months</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Consulate Visit</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Attend one appointment at your Greek consulate.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            4
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Filing & Lawyer Support</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We identify your consulate, prepare your full file, and our lawyer handles the legal submission.</p>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="relative flex flex-row items-center justify-between w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">if 12+ months</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Biometrics</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">One quick biometrics visit in Greece.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-emerald-500 text-white border-2 border-emerald-500 z-10 shadow-sm">
            <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-emerald-100 text-emerald-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Residence Permit</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Our lawyer prepares and represents your residence permit.</p>
          </div>
        </div>

      </div>
      
      <div class="mt-8 md:mt-16 text-center">
        <p class="text-xl font-medium text-slate-700 mb-8 italic">"Staying under 12 months? The consulate visit is your only in-person step — we handle the rest."</p>
        <a href="/call" class="inline-flex items-center justify-center px-10 py-4 text-lg font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 shadow-xl hover:-translate-y-1 transform">
          Book a free call
        </a>
      </div>
    </section>

    <TrustPromise />

    <!-- Moving Checklist here, centered -->
    <div class="max-w-3xl mx-auto mb-12 md:mb-24 px-4 sm:px-0">
      <section class="bg-slate-900 p-6 md:p-12 rounded-3xl shadow-xl text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 md:w-40 md:h-40 bg-slate-800 rounded-bl-full -z-0"></div>
        <div class="relative z-10">
          <div class="text-center mb-6 md:mb-8">
            <span class="inline-block px-3 py-1 mb-3 md:mb-4 text-[10px] md:text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-400/10 rounded-full">Checklist</span>
            <h2 class="text-2xl md:text-4xl font-bold mb-2 md:mb-4">Eligibility & Prerequisites</h2>
            <p class="text-sm md:text-base text-slate-300">Do you actually qualify? Here is the strict checklist:</p>
          </div>
          <ul class="space-y-2 md:space-y-4 text-sm md:text-lg text-slate-200 bg-slate-800/50 p-4 md:p-6 rounded-2xl border border-slate-700">
            <li class="flex items-start">
