---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import AboutUsShort from '../../components/AboutUsShort.astro';
import ServiceContactForm from '../../components/ServiceContactForm.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import TrustPromise from '../../components/TrustPromise.astro';
---

<Layout title="Ongoing Bookkeeping Greece | Taxomade" description="Monthly bookkeeping and tax compliance for remote workers and freelancers in Greece. Managed fully in English by our dedicated in-house team." image="/images/bookkeeping_hero_ipad.png">
  <!-- Section 1: Hero (Conversion Optimized) -->
  <div class="relative pt-32 pb-8 md:pt-40 md:pb-32 overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-white/80 via-white/50 to-slate-50/20"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Copy & CTAs -->
        <div class="max-w-2xl">
          <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tight leading-tight">
            Your Greek bookkeeping, fully handled <span class="text-blue-800">—</span> in English.
          </h1>
          <p class="text-xl text-slate-600 mb-8 leading-relaxed">
            Stay compliant every month without touching Greek bureaucracy. We take care of your monthly reporting and annual tax returns.
          </p>
          
          <!-- Benefit Checkmarks -->
          <ul class="space-y-3 mb-10">
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Monthly compliance done for you
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              E-invoicing 2026 ready
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Handled by licensed Greek accountants
            </li>
            <li class="flex items-center text-slate-700 font-medium">
              <svg class="w-6 h-6 text-emerald-500 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Simple monthly subscription
            </li>
          </ul>

          <div class="mb-10 p-4 bg-emerald-50/80 rounded-xl border border-emerald-100 flex items-start gap-3 text-emerald-800 text-sm font-medium">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <p>Bookkeeping and filings handled by our state-certified accountant &mdash; Registered with the Economic Chamber of Greece, License 0137209.</p>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <a href="#contact-form" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 shadow-md">
              Get started
            </a>
            <a href="/call" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl text-slate-700 bg-white border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors duration-200">
              Book a free call
            </a>
          </div>
          <p class="text-sm text-slate-500 font-medium flex items-center mb-1">
            <svg class="w-4 h-4 text-slate-400 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path></svg>
            Trusted by remote workers moving to Greece
          </p>
          <p class="text-sm text-slate-500 font-medium flex items-center">
            <svg class="w-4 h-4 text-slate-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            We reply within hours, 7 days a week.
          </p>
        </div>
        
        <!-- Right: Visual Mockup with Image -->
        <div class="flex justify-center lg:justify-end relative mt-2 md:mt-12 lg:mt-0">
          <div class="relative w-full max-w-lg">
            <!-- Decorative background element -->
            <div class="absolute inset-0 bg-gradient-to-tr from-blue-200 to-emerald-100 rounded-3xl transform rotate-2 scale-105 opacity-60"></div>
            
            <!-- Main Image -->
            <img src="/bookkeeping_hero_ipad.png" alt="An iPad showing financial charts on a neat white marble desk by the sea in Greece, representing bookkeeping" class="relative z-10 w-full h-[350px] sm:h-[500px] object-cover rounded-3xl shadow-2xl border-4 border-white" />
            
            <!-- Floating Price Badge -->
            <div class="absolute -bottom-6 -left-6 z-20 bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-xl border border-white flex items-center gap-4">
              <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">From €119 / mo</p>
                <p class="text-[11px] text-slate-500">Fully managed monthly service</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="py-4 md:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Why Ongoing Bookkeeping Section -->
    <div class="mb-24">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">Why do you need <span class="text-blue-800">Ongoing Bookkeeping?</span></h2>
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">Once you register as self-employed in Greece, you have strict ongoing obligations. We act as your licensed accountant to handle it all in plain English.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <!-- Benefit 1 -->
        <div class="bg-blue-50/80 rounded-3xl p-6 md:p-8 border border-blue-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">myDATA Compliance</h3>
          <p class="text-slate-600 leading-relaxed text-sm">Greece requires digital reporting of all income and expenses to the myDATA portal. We ensure everything is submitted accurately and on time.</p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-emerald-50/80 rounded-3xl p-6 md:p-8 border border-emerald-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-emerald-500 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">VAT & EFKA</h3>
          <p class="text-slate-600 leading-relaxed text-sm">We handle your quarterly VAT returns and manage your mandatory monthly social security (EFKA) payments seamlessly.</p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-purple-50/80 rounded-3xl p-6 md:p-8 border border-purple-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-purple-600 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">E-Invoicing Setup</h3>
          <p class="text-slate-600 leading-relaxed text-sm">With B2B e-invoicing becoming mandatory, we set up compliant billing systems so you can invoice international clients legally.</p>
        </div>

        <!-- Benefit 4 -->
        <div class="bg-orange-50/80 rounded-3xl p-6 md:p-8 border border-orange-100 hover:shadow-xl transition-all duration-300">
          <div class="w-12 h-12 bg-orange-500 text-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Annual Tax Return</h3>
          <p class="text-slate-600 leading-relaxed text-sm">When year-end comes, we automatically file your annual tax return (E1/E3) and provide a clear, plain-English summary of your position.</p>
        </div>
      </div>
    </div>

    <!-- Section 3: Split Timeline -->
    <section class="max-w-4xl mx-auto mb-24 px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight">How it works, <span class="text-slate-400">how little you do.</span></h2>
        <p class="text-lg text-slate-600">You send your numbers, we do the rest.</p>
      </div>
      
      <div class="relative">
        <!-- Central Line -->
        <div class="absolute left-1/2 top-4 bottom-4 w-[2px] bg-slate-100 -translate-x-1/2"></div>
        
        <!-- Step 1 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Sign Authorization</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Say yes and sign the authorization.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            1
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">One-time setup</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We register your freelancer status, EFKA, VAT and e-invoicing.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-row items-center justify-between mb-12 sm:mb-16 w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              <span class="mr-2 text-slate-400">~5 min</span> Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Send invoices</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Send us your invoices and income.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 text-xs sm:text-sm font-bold z-10 shadow-sm">
            2
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-blue-100 text-blue-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Each month</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We file your myDATA, EFKA, VAT and issue compliant e-invoices.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-row items-center justify-between w-full">
          <div class="w-[45%] text-right pr-2 sm:pr-0 text-slate-500">
            <div class="inline-flex flex-col sm:flex-row items-end sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-slate-100 text-slate-600 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              Your part
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Nothing</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">Nothing — we already have it.</p>
          </div>
          
          <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-emerald-500 text-white border-2 border-emerald-500 z-10 shadow-sm">
            <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          
          <div class="w-[45%] text-left pl-2 sm:pl-0">
            <div class="inline-flex flex-col sm:flex-row items-start sm:items-center px-2 py-1 sm:px-3 sm:py-1 rounded-xl sm:rounded-full bg-emerald-100 text-emerald-800 text-[9px] sm:text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
              taxomade®
            </div>
            <h3 class="text-[13px] sm:text-xl font-bold text-slate-900 mb-1 sm:mb-2 leading-tight">Year-end</h3>
            <p class="text-slate-500 text-[10px] sm:text-sm leading-relaxed hidden sm:block">We file your annual accounts and tax return, with a plain-English summary.</p>
          </div>
        </div>

      </div>
      
      <div class="mt-8 md:mt-16 text-center">
        <p class="text-xl font-medium text-slate-700 mb-8 italic">"You send your numbers once a month. We handle everything else — in English."</p>
        <a href="#contact-form" class="inline-flex items-center justify-center px-10 py-4 text-lg font-bold rounded-xl text-white bg-slate-900 hover:bg-blue-800 transition-colors duration-200 shadow-xl hover:-translate-y-1 transform">
          Book a free call
        </a>
      </div>
    </section>

    <!-- Checklist here, centered -->
    <div class="max-w-3xl mx-auto mb-12 md:mb-24 px-4 sm:px-0">
      <section class="bg-slate-900 p-6 md:p-12 rounded-3xl shadow-xl text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 md:w-40 md:h-40 bg-slate-800 rounded-bl-full -z-0"></div>
        <div class="relative z-10">
          <div class="text-center mb-6 md:mb-8">
            <span class="inline-block px-3 py-1 mb-3 md:mb-4 text-[10px] md:text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-400/10 rounded-full">Checklist</span>
            <h2 class="text-2xl md:text-4xl font-bold mb-2 md:mb-4">Eligibility & Prerequisites</h2>
            <p class="text-sm md:text-base text-slate-300">Here is what we need to get started:</p>
          </div>
          <ul class="space-y-2 md:space-y-4 text-sm md:text-lg text-slate-200 bg-slate-800/50 p-4 md:p-6 rounded-2xl border border-slate-700">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-emerald-400 mr-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Freelancer registration:</strong> You must be registered in Greece.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-emerald-400 mr-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Greek tax registration:</strong> You need to be registered with the Greek tax authority &mdash; if not yet, we advise you on the process.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-emerald-400 mr-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Remote employees:</strong> If you stay 183+ days, you need an annual return.</span>
            </li>
          </ul>
        </div>
      </section>
    </div>

    <!-- Pricing Package -->
    <section class="max-w-5xl mx-auto mb-12 md:mb-24 px-4 sm:px-0">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Single Service -->
        <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden relative transform transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
          <div class="absolute top-0 left-0 w-full h-1 bg-blue-800"></div>
          <div class="p-8 h-full flex flex-col">
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Freelancer Accounting</h3>
            <p class="text-slate-500 mb-6 flex-grow">Complete monthly bookkeeping, tax, and social security compliance.</p>
            <div class="mb-8">
              <div class="flex items-baseline">
                <span class="text-5xl font-black text-slate-900">€119</span>
                <span class="text-slate-500 ml-2">/ month</span>
              </div>
              <div class="text-[10px] text-slate-400 mt-2 leading-tight">plus VAT where applicable — may not apply for EU businesses with a valid VAT ID.</div>
            </div>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start text-slate-700"><svg class="w-5 h-5 text-emerald-500 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Monthly myDATA reporting & VAT returns</li>
              <li class="flex items-start text-slate-700"><svg class="w-5 h-5 text-emerald-500 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> EFKA (social security) management</li>
              <li class="flex items-start text-slate-700"><svg class="w-5 h-5 text-emerald-500 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Annual Greek tax return included</li>
              <li class="flex items-start text-slate-700"><svg class="w-5 h-5 text-emerald-500 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> E-invoicing setup & support</li>
            </ul>
            <a href="#contact-form" class="block w-full py-4 px-6 bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold rounded-xl transition-colors duration-200 text-center">Get Bookkeeping only</a>
          </div>
        </div>

        <!-- Full Package -->
        <div class="bg-slate-900 rounded-3xl shadow-2xl border border-slate-800 overflow-hidden relative transform transition duration-300 hover:-translate-y-1 hover:shadow-blue-900/50">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500 rounded-bl-full opacity-20 -z-0"></div>
          <div class="absolute top-0 left-0 w-full h-1 bg-emerald-400"></div>
          <div class="p-8 h-full flex flex-col relative z-10">
            <h3 class="text-2xl font-bold text-white mb-2">Bookkeeping + Annual Tax Return</h3>
            <p class="text-slate-400 mb-6 flex-grow">Tailored for remote employees staying 183+ days.</p>
            <div class="mb-8">
              <div class="flex items-baseline">
                <span class="text-5xl font-black text-white">Custom</span>
              </div>
