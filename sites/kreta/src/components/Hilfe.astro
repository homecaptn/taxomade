---
// Call-to-Action: Leser sollen sich bei taxomade melden (AFM, Anmeldung, Hauskauf, Firma, Buchhaltung).
import { KONTAKT } from '../data/site';
interface Props { titel?: string; text?: string }
const {
  titel = 'Keine Lust auf griechische Behörden? Wir erledigen das.',
  text = 'taxomade kümmert sich auf Deutsch um Ihren Papierkram in Griechenland, komplett aus der Ferne. Schreiben Sie uns kurz, was Sie brauchen.',
} = Astro.props;
---
<aside class="hilfe" aria-label="Hilfe beim Umzug nach Kreta">
  <p class="hilfe-titel">{titel}</p>
  <p>{text}</p>
  <ul>
    <li>AFM (Steuernummer) beantragen, schon von Deutschland aus</li>
    <li>Anmeldung, AMKA, Steuerwohnsitz und Steuervorteile (50 % bzw. 7 %)</li>
    <li>Hauskauf: AFM, Bankkonto, Steuern und Pflichten nach dem Kauf</li>
    <li>Selbstständigkeit, Firmengründung und laufende Buchhaltung</li>
  </ul>
  <p class="hilfe-btns">
    <a class="btn" href={KONTAKT.formular}>Anfrage senden</a>
    <a class="btn ghost" href={KONTAKT.whatsapp} rel="noopener" target="_blank">Per WhatsApp schreiben</a>
  </p>
  <p class="small">Unverbindlich, auf Deutsch. Sie bekommen eine Antwort per E-Mail, ganz ohne Telefonat.</p>
</aside>
