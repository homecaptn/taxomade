---
import Base from '../../layouts/Base.astro';
import Cards from '../../components/Cards.astro';
import { LEBEN } from '../../data/site';
---
<Base
  image="cafe"
  imageAlt="Café in einer Altstadtgasse auf Kreta"
  title="Leben auf Kreta: Wohnen, Kosten, Ärzte, Schulen, Arbeit"
  description="Alles zum Alltag auf Kreta: Wohnung mieten, Haus kaufen, Lebenshaltungskosten, Ärzte und Krankenversicherung, Schulen, Arbeiten, Auto und Wetter."
  h1="Leben auf Kreta"
  lead="Hier finden Sie die Themen, die nach dem Umzug den Alltag bestimmen. Kurz, ehrlich und mit dem, was Sie vor Ort wirklich brauchen."
  crumbs={[{ href: '/leben/', label: 'Leben auf Kreta' }]}
  article={false}
>
  <Cards items={LEBEN} />
  <p>Noch ganz am Anfang? Dann starten Sie mit der <a href="/checkliste/">Checkliste in 10 Schritten</a> oder dem <a href="/regionen/">Regionen-Vergleich</a>.</p>
</Base>
